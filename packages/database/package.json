{
  "name": "@audio/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema-check": "./src/schema-check.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "pnpm db:ext && dotenv -e ../../.env -- prisma db push && pnpm db:vector",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:vector": "docker exec -i postgres psql -U postgres -d audio_truyen -f - < sql/001-vector.sql",
    "db:ext": "docker exec -i postgres psql -U postgres -d audio_truyen -f - < sql/000-extension.sql",
    "db:push:player": "dotenv -e ../../.env -- tsx scripts/push-player.mts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
