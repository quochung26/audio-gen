{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // `prisma generate` writes to node_modules/.prisma at the REPO ROOT — outside this
    // package's directory, so turbo cannot restore it from cache. Enabling the cache here
    // would mean a cache hit skips generating the client and leaves the old one in place,
    // which is exactly the bug to avoid.
    "build": {
      "cache": false,
      "outputs": []
    }
  }
}
