// The full schema plus the reasoning behind the design: docs/database.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════ ENUM ══════════════════════════

enum SeriesKind {
  SHORT
  LONG
}

enum SeriesStatus {
  DRAFT
  ONGOING
  COMPLETED
  ARCHIVED
}

enum EpisodeStatus {
  IDEA
  OUTLINED
  DRAFTING
  DRAFTED
  SCRIPTED
  RENDERING
  READY
  PUBLISHED
  FAILED
}

enum TtsEngine {
  MOCK
  KOKORO
  PIPER
  VIXTTS
  F5TTS
}

enum VoiceTier {
  FAST
  EXPRESSIVE
}

enum JobLane {
  LLM
  TTS_CPU
  TTS_GPU
  FFMPEG
}

enum JobType {
  /// Invent one character. Runs in the LLM lane like any other model call — going
  /// straight to the model from the API would bypass the VRAM guard and collide
  /// with a scene write already loaded on the card.
  CHARACTER
  /// Advances a batch run to its next step. Attached to no episode and using no
  /// VRAM — it only reads state and queues the real job. Thanks to it, Studio only
  /// has to enqueue rather than carry the orchestration logic.
  BATCH
  OUTLINE
  NEXT_EPISODE
  WRITE_SCENE
  /// Rewrite the draft into the output language. Only runs when Series.draftLanguage
  /// differs from Series.language — see packages/core/src/language.ts.
  TRANSLATE
  AUDIO_EDIT
  SUMMARIZE
  ARC_SUMMARY
  METADATA
  TTS
  MIX
  VIDEO
  SUBTITLE
  PUBLISH
  MOCK
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum ExportType {
  /// The current master — MP3 at −16 LUFS (podcast/web).
  AUDIO_MP3
  /// Platform exports: deferred. TikTok and YouTube both want VIDEO, not MP3.
  TIKTOK_MP4
  YOUTUBE_MP4
  /// The script with timecodes — useful for video descriptions and subtitles.
  SCRIPT_TXT
}

/// Story genres — one catalogue for both main and sub-genres.
///
/// `description` is NOT a note for human readers: it goes into the Story Bible so
/// the model reads "kinh dị" the way you mean it, rather than however it guesses.
/// Changing a description changes how every story in that genre is written, from
/// the next write onward.
model Genre {
  id   String @id @default(cuid())
  /// Exactly the string in `Series.genre` and in `Series.tags`.
  ///
  /// Both the lookup KEY and the LABEL listeners see: the Player home page filters
  /// on it, the story page prints it, and it goes into the RSS feed's
  /// `itunes:keywords`. So it stays in the listener's language, never translated.
  name String @unique

  /// The name handed to the MODEL instead of `name`. Blank falls back to `name`.
  ///
  /// Separate because the two pull in opposite directions: `kinh dị` is what
  /// listeners search for, while `horror` is what a 7–14B model has far richer
  /// associations for — it saw that label millions of times in training. One field
  /// would mean sacrificing one of them.
  promptName String @default("")

  /// What the genre means, written as an INSTRUCTION to the model. See seed.ts.
  description String

  /// Disabled hides it from the picker, but stories already using it keep it.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PromptStep {
  OUTLINE
  /// Invent ONE character on demand, for a story that already exists or one being
  /// typed. Separate from OUTLINE because the outline no longer invents anybody:
  /// a chosen cast is closed, and this is the button that adds to it.
  CHARACTER
  /// Outline ONE more episode, based on the ones that exist.
  NEXT_EPISODE
  WRITE_SCENE
  /// Rewrite the draft into the output language.
  TRANSLATE
  AUDIO_EDIT
  SUMMARIZE
  ARC_SUMMARY
  METADATA
}

enum AudioTrackKind {
  BGM
  SFX
  INTRO
  OUTRO
}

enum LicenseType {
  ROYALTY_FREE
  CC0
  CC_BY
  PURCHASED
  SELF_MADE
  UNKNOWN
}

/// The kind of fact. It matters because retrieval differs:
/// OPEN_THREAD is loaded WHATEVER the similarity — it is a debt the story owes.
enum FactKind {
  EVENT // something that happened
  REVELATION // something a character found out
  PROMISE // an oath, a promise, a commitment
  RELATION // a relationship between characters changing
  OBJECT // an important object
  PLACE // a place that means something
  OPEN_THREAD // an open thread, not yet resolved
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ══════════════════ CONTENT ══════════════════

model Series {
  id          String       @id @default(cuid())
  kind        SeriesKind   @default(LONG)
  title       String
  slug        String       @unique
  description String?
  coverUrl    String?
  genre       String
  tags        String[]     @default([])
  status      SeriesStatus @default(DRAFT)

  /// What language the story is written in — "vi" or "en". See packages/core/src/language.ts.
  /// Attached to the STORY rather than to each episode: mixing languages between
  /// episodes wrecks the arc summary, the character names and the voices alike.
  language String @default("vi")

  /// Write the DRAFT in this language, then rewrite it into `language`.
  ///
  /// Blank = write directly in `language`, with no rewrite step. Set it when the
  /// model that writes best cannot write the output language — for instance an
  /// English creative-writing finetune used for a Vietnamese story.
  ///
  /// Changes the language of the WRITE_SCENE step only. The outline is still built in
  /// `language` so character and place names are right from the start — the model
  /// writes English prose around existing Vietnamese names, rather than inventing a
  /// Sarah you then translate forever.
  draftLanguage String @default("")

  /// World rules, setting, prose voice. Characters do NOT live here — see the Character model.
  storyBible Json?

  aiDisclosure Boolean @default(true)

  /// The default voice for the whole story. Currently ONE voice for every block;
  /// per-character casting (Character.voiceId) is only for multi-voice work.
  defaultVoiceId String?
  defaultVoice   Voice?  @relation("SeriesDefaultVoice", fields: [defaultVoiceId], references: [id])

  /// The arc summary — old episodes compressed into one block.
  /// Without it, per-episode summaries accumulate linearly and overflow the context
  /// around episode 35. See docs/database.md section 2.9.
  arcSummary        String?
  /// Which episode number the compression covers up to.
  arcThroughEpisode Int?

  episodes       Episode[]
  characters     Character[]
  pronunciations PronunciationEntry[]
  facts          StoryFact[]
  batchRuns      BatchRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([genre])
}

model Episode {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  number Int
  title  String
  slug   String @unique

  outline Json?

  draftText  String?
  scriptText String?
  summary    String?
  /// One ~15-word line for the story index. Always loaded (it is cheap), so the
  /// system and the writer know what happened where — even after the summary was compressed.
  gist       String?

  /// The gate: unapproved means it cannot move on to the audio step.
  humanReviewed Boolean   @default(false)
  reviewedAt    DateTime?
  reviewedBy    String?

  status     EpisodeStatus @default(IDEA)
  durationMs Int?
  wordCount  Int?

  bgmTrackId   String?
  bgmTrack     AudioTrack? @relation("EpisodeBgm", fields: [bgmTrackId], references: [id])
  bgmVolume    Float       @default(0.18)
  introTrackId String?
  outroTrackId String?

  publishedAt DateTime?
  /// The last push to the hosted DB. Compared against the episode's, the blocks' and
  /// the exports' `updatedAt` to tell whether live has drifted from local — editing a
  /// title or re-exporting the MP3 after publishing leaves live on the old version
  /// with nothing to say so.
  syncedAt    DateTime?

  chapters   Chapter[]
  blocks     Block[]
  exports    Export[]
  facts      StoryFact[]
  llmRuns    LlmRun[]
  renderJobs RenderJob[]
  progress   ListenProgress[]
  favorites  Favorite[]
  comments   Comment[]
  ratings    Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, number])
  @@index([status])
  @@index([publishedAt])
  @@index([seriesId, publishedAt])
}

model Character {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  name        String
  role        String?
  description String?

  /// Speech: rhythm, verbal habits, forms of address, what they do when moved.
  ///
  /// Separate from `description` because this is what the model leans on when writing
  /// DIALOGUE, while personality steers action and choices. Also DIFFERENT from
  /// `voiceHint`: that one is the timbre for TTS casting, and the model never reads it.
  speech String?

  /// Their USUAL outfit — a default, not a constant.
  ///
  /// The base tier of the override chain: this default → `Episode.setup` → `Scene.setup`.
  /// Without this tier, a story with no chapter setup filled in leaves the model with
  /// no clothing information at all, and it invents something new every chapter.
  ///
  /// Different from `appearance` in being OVERRIDABLE: `appearance` is build, face,
  /// scars — things that do not change across the story and no tier overrides.
  outfit String?

  /// Appearance, UNCHANGING across the story: build, apparent age, face, scars.
  ///
  /// Separate from `description` because the two are used differently: personality
  /// steers DIALOGUE, appearance steers DESCRIPTION and is the basis for the cover
  /// image prompt. Merged, the model describes clothing in a passage that needed a voice.
  ///
  /// Outfits belong in `outfit`, which changes per chapter while this does not.
  appearance String?

  isNarrator Boolean @default(false)

  /// Current state: where they are, what they know, how relationships have changed.
  /// DIFFERENT from `description` (personality, speech — static, set by the writer):
  /// `state` moves with the story and is updated after every episode.
  state               String?
  /// Which episode number the state reflects up to.
  stateThroughEpisode Int?

  voiceHint String?
  voiceId   String?
  voice     Voice?  @relation(fields: [voiceId], references: [id])

  /// The character card this character was built from, if any.
  ///
  /// Only PROVENANCE, not a live link: editing a character inside a story does not
  /// touch the card, and editing the card does not touch the stories that used it.
  /// Pushing an edit back to the card is a separate action the writer has to click.
  cardId String?
  card   CharacterCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  blocks Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, name])
  @@index([seriesId, isNarrator])
  @@index([cardId])
}

/// Character cards — characters reusable across stories.
///
/// Why separate from `Character`: a `Character` belongs to ONE story and carries
/// state along that story's arc (`state`, `stateThroughEpisode`, rendered blocks).
/// A card has no arc at all — it is the source description to carry into another
/// story. Merged, one story's "narrator with the hoarse voice" would drag along the
/// fact that he died in episode 12 of another.
///
/// Not synced to the Player: this is a local-only table, like `Genre` and `Prompt`.
model CharacterCard {
  id String @id @default(cuid())

  /// Unique so a clash is reported clearly rather than producing two identical-looking cards.
  name        String  @unique
  role        String?
  description String?

  /// Speech: rhythm, verbal habits, forms of address, what they do when moved.
  ///
  /// Separate from `description` because this is what the model leans on when writing
  /// DIALOGUE, while personality steers action and choices. Also DIFFERENT from
  /// `voiceHint`: that one is the timbre for TTS casting, and the model never reads it.
  speech String?

  /// Their USUAL outfit — a default, not a constant.
  ///
  /// The base tier of the override chain: this default → `Episode.setup` → `Scene.setup`.
  /// Without this tier, a story with no chapter setup filled in leaves the model with
  /// no clothing information at all, and it invents something new every chapter.
  ///
  /// Different from `appearance` in being OVERRIDABLE: `appearance` is build, face,
  /// scars — things that do not change across the story and no tier overrides.
  outfit String?

  /// Appearance, UNCHANGING across the story: build, apparent age, face, scars.
  ///
  /// Separate from `description` because the two are used differently: personality
  /// steers DIALOGUE, appearance steers DESCRIPTION and is the basis for the cover
  /// image prompt. Merged, the model describes clothing in a passage that needed a voice.
  ///
  /// Outfits belong in `outfit`, which changes per chapter while this does not.
  appearance String?
  voiceHint  String?

  /// This card is a narrator by default. Only a default when brought into a story —
  /// each story still gets exactly one narrator, and that is the story's rule.
  isNarrator Boolean @default(false)

  /// The preferred voice. `Voice` is a shared table, so it carries across stories.
  voiceId String?
  voice   Voice?  @relation(fields: [voiceId], references: [id])

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Chapter — the tier between EPISODE and SCENE.
///
/// A story has many episodes; an episode has many chapters; a chapter has many
/// scenes. The episode is what the LISTENER receives (one MP3, one RSS item); the
/// scene is what the MODEL WRITES in one go (600–900 words, past which a 14B model
/// loses the thread); the chapter is the unit of STORYTELLING in between — one
/// movement with an opening and a close, usually one sitting in one place.
///
/// `setup` used to live on `Episode`, and that was the wrong place: it describes one
/// movement, not a whole episode. The override chain is now three proper tiers —
/// character card → chapter → scene.
model Chapter {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  order Int
  title String?

  /// What this chapter drives at, its own voice, what must happen, what is forbidden,
  /// and character overrides (what they wear, injuries…). Overrides here beat the
  /// Story Bible, and `Scene.setup` beats these. See packages/core/src/chapter-setup.ts.
  setup Json?

  scenes Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, order])
  @@index([episodeId])
}

model Scene {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  order Int
  beat  String
  /// The version actually used — always in the story's output language.
  text  String?

  /// The draft before the rewrite, kept so the prompt can be edited and TRANSLATE
  /// rerun without rewriting the scene. Null = the scene has not been through the
  /// rewrite, which is also how the TRANSLATE step knows what is left to do.
  sourceText String?

  /// Who is present in this scene. EMPTY means "not known", not "nobody" — the Story
  /// Bible then loads every character in full, which is the old behaviour.
  ///
  /// With a list, only these people are described in full in the Bible; the rest keep
  /// only name and role. Context therefore does not grow with the cast — a 20-person
  /// cast in a 2-person scene means 18 descriptions paid for and wasted.
  ///
  /// The "not known" default is deliberate: guessing one person short only loses the
  /// filtering, rather than making the model write a scene missing its own people.
  characterIds String[] @default([])

  /// The SCENE's own setup: notes, and character overrides for this scene alone.
  /// Overrides `Chapter.setup` FIELD BY FIELD — a scene saying only "changed into a
  /// raincoat" leaves the chapter's "hand bandaged" note intact.
  setup Json?

  /// The numbers of earlier episodes this scene calls back to.
  /// Only the episodes listed here get their FULL summary loaded — instead of
  /// stuffing in every summary each time. The system suggests, the writer can edit.
  refEpisodes Int[] @default([])

  approved Boolean @default(false)

  llmRuns LlmRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, order])
  @@index([chapterId])
}

/// Configuration editable from the UI.
///
/// Why this table rather than leaving it in `.env`: changing the default model is a
/// routine thing while trying out which one writes better, and editing `.env` means
/// restarting the worker. Env is still the fallback when nothing has been set.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}

/// Story facts — the unit of semantic retrieval.
///
/// Why NOT embed `Episode.summary`: a 200-word summary packs 3–4 different things
/// together, and one vector smears them. Split into one sentence per fact, each
/// vector is sharp, and you can pull 5 facts from 5 different episodes rather than
/// 3 monolithic summaries.
///
/// More importantly, facts live INDEPENDENTLY of summary compression. The
/// ARC_SUMMARY job compresses old summaries and loses detail, but facts stay intact here.
///
/// The `embedding` column is declared `Unsupported` — Prisma cannot generate a type
/// for it, so it still has to be read and written with `$queryRaw`/`$executeRaw` (see
/// services/fact-store). But DECLARING it is mandatory: left out, `prisma db push`
/// treats the column as surplus and drops it along with every embedded vector. See
/// packages/database/sql/.
model StoryFact {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// The episode that produced this fact. Keeps the number too, so queries need no join.
  episodeId     String?
  episode       Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  episodeNumber Int

  kind FactKind
  /// One sentence, standing on its own without context.
  /// E.g. "Tài thề không bao giờ quay lại Bến Cũ sau đêm mưa."
  text String

  /// Whether an open thread has been resolved. Applies to OPEN_THREAD only.
  resolved          Boolean @default(false)
  resolvedInEpisode Int?

  /// Pinned by the writer means always loaded, whatever the similarity.
  pinned Boolean @default(false)

  /// bge-m3 returns 1024 dimensions. Changing model means changing this and re-embedding everything.
  embedding Unsupported("vector(1024)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId, kind])
  @@index([seriesId, episodeNumber])
  @@index([seriesId, resolved])
}

// ══════════════════ AUDIO ══════════════════

model Voice {
  id     String    @id @default(cuid())
  engine TtsEngine
  tier   VoiceTier

  name            String
  externalVoiceId String
  refAudioUrl     String?

  gender    String?
  ageRange  String?
  accent    String?
  sampleUrl String?

  /// Which languages this voice can read. A Vietnamese voice reading English prose is
  /// unlistenable, so this is a filter condition rather than a note.
  language String @default("vi")

  licenseType  LicenseType @default(UNKNOWN)
  commercialOk Boolean     @default(false)

  enabled Boolean @default(true)

  characters      Character[]
  characterCards  CharacterCard[]
  seriesAsDefault Series[]        @relation("SeriesDefaultVoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([engine, externalVoiceId])
  @@index([tier, enabled])
}

model Block {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  order Int
  text  String

  characterId  String?
  character    Character? @relation(fields: [characterId], references: [id])
  speakerLabel String

  /// A snapshot of the configuration at render time — DELIBERATELY not a foreign key.
  /// Change the casting and the cacheKey changes with it, so the system knows to re-render.
  ttsEngine TtsEngine
  voiceId   String
  speed     Float     @default(1.0)
  pitch     Float?

  pauseAfter Int         @default(400)
  sfxHint    String?
  sfxTrackId String?
  sfxTrack   AudioTrack? @relation("BlockSfx", fields: [sfxTrackId], references: [id])

  audioAssetId String?
  audioAsset   AudioAsset? @relation(fields: [audioAssetId], references: [id])

  approved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, order])
  @@index([episodeId, approved])
  @@index([characterId])
}

/// An audio cache shared across every episode. A fixed intro/outro renders once.
model AudioAsset {
  id String @id @default(cuid())

  /// sha256(text + ttsEngine + voiceId + speed + pitch)
  cacheKey String @unique

  /// The KEY in the store ("series/abc/blocks/x.wav"), NOT an absolute path: renaming
  /// the project directory or moving machines breaks every absolute path. Resolved
  /// against the store root by `StorageDriver.resolve`.
  url        String
  durationMs Int
  sizeBytes  Int
  sampleRate Int    @default(24000)

  ttsEngine TtsEngine
  voiceId   String

  refCount Int @default(0)

  blocks Block[]

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
}

model AudioTrack {
  id   String         @id @default(cuid())
  kind AudioTrackKind

  title      String
  /// The store key when uploaded, or an `https://` URL when an external source is pasted.
  url        String
  durationMs Int
  mood       String?
  tags       String[] @default([])

  /// Required — UNKNOWN blocks publishing.
  licenseType LicenseType @default(UNKNOWN)
  licenseNote String?
  attribution String?

  episodesAsBgm Episode[] @relation("EpisodeBgm")
  blocksAsSfx   Block[]   @relation("BlockSfx")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, licenseType])
}

model PronunciationEntry {
  id String @id @default(cuid())

  /// null = the dictionary shared by every story
  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  term        String
  replacement String
  isRegex     Boolean @default(false)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId, term])
}

// ══════════════════ PUBLISHING ══════════════════

model Export {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  type ExportType

  part      Int @default(1)
  partTotal Int @default(1)

  /// The store key — see AudioAsset.url.
  url        String
  sizeBytes  Int?
  durationMs Int?

  sampleRate  Int?
  bitDepth    Int?
  bitrateKbps Int?
  lufs        Float?
  codec       String?

  platformUrl String?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, type, part])
  @@index([type, publishedAt])
}

// ══════════════════ AI & QUEUE ══════════════════

model Prompt {
  id      String     @id @default(cuid())
  step    PromptStep
  /// The genre variant. "*" = applies to every genre.
  /// "*" rather than null because Postgres treats every NULL as distinct — a unique
  /// constraint on a nullable column would not block duplicate rows.
  genre   String     @default("*")
  version Int        @default(1)

  content String
  model   String?
  params  Json?

  active Boolean @default(true)
  note   String?

  llmRuns LlmRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([step, genre, version])
  @@index([step, active])
}

/// Telemetry for every LLM call. Records time and speed, not money — with a local
/// model, machine time is the scarce resource.
model LlmRun {
  id String @id @default(cuid())

  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  sceneId   String?
  scene     Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  promptId  String?
  prompt    Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)

  step   PromptStep
  model  String
  params Json

  inputTokens  Int
  outputTokens Int
  durationMs   Int
  tokensPerSec Float

  /// Your own score after reading — to learn which prompt and parameters write well.
  qualityRating Int?
  qualityNote   String?

  error String?

  createdAt DateTime @default(now())

  @@index([step, createdAt])
  @@index([model, qualityRating])
  @@index([episodeId])
}

/// The status of a batch run.
/// Separate from JobStatus because of WAITING_REVIEW — a status no job has: the run
/// is alive but waiting for a person to read and approve the draft.
enum BatchStatus {
  RUNNING
  WAITING_REVIEW
  DONE
  FAILED
  CANCELLED
}

/// One batch run: carrying each episode of a story through the whole chain,
/// write scene → (approve) → audio script → summary → TTS → mix MP3.
///
/// Orchestrated by EVENTS rather than a polling loop: as each job finishes,
/// `advanceBatch` reads the episode's status and queues the next step. A polling loop
/// would hold a lane slot for its whole run, and the LLM lane has only a few slots.
model BatchRun {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  status BatchStatus @default(RUNNING)

  /// Skip the draft approval gate. For TESTING ONLY — see docs/database.md section 4.
  autoApprove Boolean @default(false)
  /// Carry on into TTS + mixing the MP3, or stop once the audio script exists.
  withAudio   Boolean @default(true)

  /// The episode being processed — also the one awaiting approval when status = WAITING_REVIEW.
  currentEpisodeId String?

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([seriesId, status])
}

model RenderJob {
  id        String   @id @default(cuid())
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  type   JobType
  lane   JobLane
  status JobStatus @default(QUEUED)

  /// The VRAM this job needs. CPU jobs declare 0.
  vramMb Int @default(0)

  progress Int     @default(0)
  payload  Json?
  result   Json?
  error    String?

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, lane, queuedAt])
  @@index([episodeId, status])
}

// ══════════════════ LISTENERS ══════════════════

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?

  /// A scrypt hash, present only for password signups. Signing in with Google leaves
  /// it null — and it must NEVER be set, or there would be a way to brute-force into
  /// an account that never had a password.
  passwordHash String?

  role String @default("listener")

  accounts  Account[]
  sessions  Session[]
  progress  ListenProgress[]
  favorites Favorite[]
  comments  Comment[]
  ratings   Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An account at an external provider (Google…). Auth.js owns this table.
/// One User can have several Accounts — sign in with Google, then add a password.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model ListenProgress {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  positionMs Int     @default(0)
  completed  Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model Favorite {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, episodeId])
}

model Comment {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  body        String
  timestampMs Int?

  status ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([episodeId, status, createdAt])
}

model Rating {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  score Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, episodeId])
  @@index([episodeId])
}
