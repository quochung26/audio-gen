# ─── Databases ───
# Local (everything: drafts, prompts, telemetry) — never leaves the machine
DATABASE_URL="postgresql://postgres:dev@localhost:5433/audio_truyen"
# Hosted (published content only) — what the Player reads.
# LEAVE IT BLANK = share one DB with Studio. Handy while building the app, but then
# there is no boundary at all: the Player can see the drafts, it merely does not query them.
# Before deploying the Player publicly this MUST be set, then run `pnpm db:push:player`.
PLAYER_DATABASE_URL=""
# The Player's public URL root — the podcast RSS needs absolute URLs.
# Blank infers it from the request (fine locally, wrong behind a proxy).
PLAYER_PUBLIC_URL=""

REDIS_URL="redis://localhost:6380"

# Studio's API port. The Vite dev proxy sends /api here; in production the API also
# serves the built UI, so only one port is needed.
API_PORT=3002

# ─── AI providers ───
# mock  = the mock, needs no GPU (for building the app)
# ollama / kokoro / piper / vixtts = real
# openrouter = cloud models (costs money, and content leaves this machine)
LLM_PROVIDER="mock"
TTS_PROVIDER="mock"
# Tier 2 (voice cloning, GPU) — Phase 5. ⚠️ viXTTS/XTTS-v2 FORBID commercial use.
TTS_EXPRESSIVE_PROVIDER="mock"
PIPER_BINARY="piper"
# The directory holding piper voice files (.onnx). Blank lets piper find its own default.
PIPER_VOICES_DIR=""

# The default language for NEW stories — "vi" or "en". Only the value pre-filled on the
# create-story screen; each story keeps its own, fixed at creation and never changed.
CONTENT_LANGUAGE="vi"

# WHICH MODEL DOES WHICH JOB IS NOT HERE.
# It follows what is actually downloaded, or what you pick on Studio's /model page.
# Writing a model name into .env makes that name a lie the moment the machine does not
# have it — the job dies mid-run instead of saying so when Studio opens.

# Embeddings for fact retrieval. Runs on CPU, takes no VRAM.
# mock = a deterministic hash (verifies the data path only) | ollama = real
EMBED_PROVIDER="mock"

OLLAMA_URL="http://localhost:11434"

# ─── OpenRouter (optional) ───
# The gateway to hundreds of cloud models. Get a key at openrouter.ai/keys.
#
# ⚠️ Turning this on means the Story Bible, the drafts and the dialogue LEAVE THIS MACHINE.
#    The whole two-database architecture exists to keep drafts here; this is a deliberate exception.
#
# ONE provider runs at a time. This is only the starting value; changing it on Studio's
# /model page writes the choice to the DB and takes effect immediately, with no worker
# restart. The default model is remembered separately per provider.
OPENROUTER_API_KEY=""
OPENROUTER_URL="https://openrouter.ai/api/v1"

KOKORO_URL="http://localhost:8880"
VOICE_CLONE_URL="http://localhost:8881"

# ─── VRAM budget (MB) — see PLAN.md section 3 ───
VRAM_TOTAL_MB=16384
VRAM_RESERVED_MB=2048
VRAM_LLM_MB=12288
VRAM_TTS_CLONE_MB=4096

# ─── Sign-in (the player) ───
# REQUIRED in production. Generate with: openssl rand -base64 32
# Changing this key signs everyone out.
AUTH_SECRET=""
# Google OAuth — blank hides the "Sign in with Google" button, and email + password
# sign-in still works. Create one in Google Cloud Console → OAuth client ID,
# redirect URI: <PLAYER_PUBLIC_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Storage ───
# local = write to a directory (for building the app) | r2 = Cloudflare R2
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="audio-truyen"
R2_PUBLIC_URL=""
