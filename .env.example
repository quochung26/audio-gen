# ─── Cơ sở dữ liệu ───
# Local (đầy đủ: bản thảo, prompt, telemetry) — không bao giờ rời máy
DATABASE_URL="postgresql://postgres:dev@localhost:5433/audio_truyen"
# Hosted (chỉ nội dung đã xuất bản) — Player đọc.
# ĐỂ TRỐNG = chạy chung một DB với Studio. Tiện lúc dựng app, nhưng lúc đó
# không còn ranh giới nào: Player nhìn thấy cả bản thảo, chỉ là không truy vấn tới.
# Trước khi deploy Player ra ngoài PHẢI đặt biến này, rồi chạy `pnpm db:push:player`.
PLAYER_DATABASE_URL=""
# Gốc URL công khai của Player — RSS podcast cần URL tuyệt đối.
# Để trống thì suy từ request (đủ khi chạy tại chỗ, sai khi sau proxy).
PLAYER_PUBLIC_URL=""

REDIS_URL="redis://localhost:6380"

# Cổng API của Studio. Vite dev proxy /api sang đây; chạy production thì API
# phục vụ luôn bản build của giao diện nên chỉ cần một cổng.
API_PORT=3002

# ─── Nhà cung cấp AI ───
# mock  = giả lập, không cần GPU (dùng khi dựng app)
# ollama / kokoro / piper / vixtts = thật
LLM_PROVIDER="mock"
TTS_PROVIDER="mock"
# Tầng 2 (clone giọng, GPU) — Phase 5. ⚠️ viXTTS/XTTS-v2 CẤM dùng thương mại.
TTS_EXPRESSIVE_PROVIDER="mock"
PIPER_BINARY="piper"
# Thư mục chứa file giọng piper (.onnx). Bỏ trống thì piper tự tìm theo mặc định.
PIPER_VOICES_DIR=""

# Embedding cho truy hồi sự kiện. Chạy CPU, không chiếm VRAM.
# mock = băm tất định (chỉ kiểm chứng đường đi) | ollama = thật
EMBED_PROVIDER="mock"
EMBED_MODEL="bge-m3"

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL_WRITE="qwen3:14b"
OLLAMA_MODEL_UTILITY="qwen3:8b"

KOKORO_URL="http://localhost:8880"
VOICE_CLONE_URL="http://localhost:8881"

# ─── Ngân sách VRAM (MB) — xem PLAN.md mục 3 ───
VRAM_TOTAL_MB=16384
VRAM_RESERVED_MB=2048
VRAM_LLM_MB=12288
VRAM_TTS_CLONE_MB=4096

# ─── Lưu trữ ───
# local = ghi ra thư mục (dùng khi dựng app) | r2 = Cloudflare R2
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="audio-truyen"
R2_PUBLIC_URL=""
